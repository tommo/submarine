%YAML 1.2
---
name: Session List
scope: text.session-list
hidden: true

contexts:
  main:
    - match: '^SESSIONS\b'
      scope: markup.heading.session-list
      push: header_rest

    - match: '^(CURRENT|HISTORY)\s+\((\d+)\)'
      captures:
        0: entity.name.section.session-list
        2: constant.numeric.session-list

    - match: '^\s+\(none\)$'
      scope: comment.line.session-list

    # Row lead: the current-session column — `▸ ` on the session this window
    # shows, `  ` on any other live row — then the state mark. Only live rows
    # carry it, so its fixed offsets are ui/session_list.py:_fmt_row's.
    - match: '^▸ '
      scope: keyword.bound.session-list
      push: row_lead

    - match: '^  (?=[⊡●!?○⏸·])'
      push: row_lead

    - match: '^⊡'
      scope: keyword.torn-off.session-list
      push: row_rest

    - match: '^●'
      scope: keyword.working.session-list
      push: row_rest

    - match: '^\?'
      scope: keyword.input.session-list
      push: row_rest

    - match: '^!'
      scope: keyword.unread.session-list
      push: row_rest

    - match: '^○'
      scope: keyword.ready.session-list
      push: row_rest

    - match: '^⏸'
      scope: keyword.sleeping.session-list
      push: row_rest

    - match: '^·'
      scope: comment.mark.session-list
      push: row_rest

  row_lead:
    - match: '⊡'
      scope: keyword.torn-off.session-list
      set: row_rest

    - match: '●'
      scope: keyword.working.session-list
      set: row_rest

    - match: '\?'
      scope: keyword.input.session-list
      set: row_rest

    - match: '!'
      scope: keyword.unread.session-list
      set: row_rest

    - match: '○'
      scope: keyword.ready.session-list
      set: row_rest

    - match: '⏸'
      scope: keyword.sleeping.session-list
      set: row_rest

    - match: '·'
      scope: comment.mark.session-list
      set: row_rest

    - match: '$'
      pop: true

  header_rest:
    - match: '\b(enter|dclick|r|v|t|s|f|j)\b'
      scope: keyword.operator.session-list
    - match: '\b(open|rename|reveal|tear|star|fork|jsonl)\b'
      scope: comment.line.session-list
    - match: '·'
      scope: comment.line.session-list
    - match: '$'
      pop: true

  row_rest:
    - match: '↳'
      scope: comment.tree.session-list
    - match: '[△★✨]'
      scope: keyword.star.session-list
    # First token is the backend column (padded to 8, or compact GR/CL).
    # Custom providers (stepfun, openrouter, …) must match too — otherwise
    # we never enter row_title and the rest of the line loses its colors.
    - match: '(?:[A-Za-z][A-Za-z0-9_-]{0,7}|[A-Z]{2,3})\b'
      scope: storage.type.backend.session-list
      set: row_title
    - match: '$'
      pop: true

  row_title:
    # The pin sits between the backend column and the title.
    - match: '✨'
      scope: keyword.star.session-list
    - match: '\s+\d+q\b'
      scope: comment.nq.session-list
    - match: '\s+(busy)\s*$'
      scope: keyword.working.session-list
      pop: true
    - match: '\s+(wait)\s*$'
      scope: keyword.input.session-list
      pop: true
    - match: '\s+(new)\s*$'
      scope: keyword.unread.session-list
      pop: true
    - match: '\s+(idle)\s*$'
      scope: keyword.ready.session-list
      pop: true
    - match: '\s+(now|<1m|\d+[smhdw])\s*$'
      scope: comment.line.time.session-list
      pop: true
    - match: '$'
      pop: true
